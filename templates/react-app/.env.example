# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust. `init.sh` does this for you and also
# generates a random SECRET_KEY and remaps host ports into an 80xx block.
# ──────────────────────────────────────────────────────────────────────────

# --- App ---
APP_NAME=Full App Template
APP_ENV=development
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
TZ=Europe/Bucharest

# --- Database (Postgres) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# DATABASE_URL is consumed by the backend. The host is the compose service name `db`.
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# --- Auth / JWT ---
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-init-sh
# 7 days. Shorten this when you add refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vite) ---
# Origin only. Request paths already include /api/v1.
# Empty means "same origin" (the production nginx image).
VITE_API_URL=http://localhost:8000

# --- Redis (runs in the default compose file) ---
REDIS_URL=redis://redis:6379/0

# --- pgAdmin (dev only) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Flower (optional overlay only). Change the password before exposing it. ---
FLOWER_USER=admin
FLOWER_PASSWORD=change-me

# --- Host port mapping ---
# Defaults below are the usual local ports. `init.sh` rewrites them to a block:
#   xx40 web, xx41 API, xx42 database, xx43 Redis, xx49 pgAdmin, xx55 Flower, xx80 proxy
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
PGADMIN_PORT=5050
REDIS_PORT=6379
FLOWER_PORT=5555
PROXY_PORT=8080
