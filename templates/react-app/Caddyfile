# Reverse proxy for the optional overlay.
# /api/* (including /api/v1) and the OpenAPI docs go to FastAPI.
# Everything else goes to the Vite dev server.
:80 {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /redoc* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:5173
	}
}
